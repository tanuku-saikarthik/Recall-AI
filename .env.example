# Web Server Configuration
HOST=127.0.0.1
PORT=8000

# Database & Index Paths
DB_PATH=metadata.db
FAISS_INDEX_PATH=vectors.faiss

# Embedding Model Configuration
# Note: The first run will automatically download this model from HuggingFace
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_FILE_SIZE_MB=100

# LLM Fallback Configuration (Optional: requires Ollama installed locally)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
